{
  "name": "canvas-collab",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time collaborative whiteboard built on Yjs, a hand-rolled y-protocols WebSocket server, and React.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,web --prefix-colors blue,magenta \"npm run dev -w @canvas-collab/server\" \"npm run dev -w @canvas-collab/web\"",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @canvas-collab/server",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.4.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true
  }
}
