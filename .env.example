# ---- server (apps/server) ----
# Copy to apps/server/.env (or export in your shell). All values are validated at boot.

NODE_ENV=development
HOST=0.0.0.0
PORT=1234
LOG_LEVEL=info

# HS256 signing secret for room tokens. Required (>= 32 chars) when NODE_ENV=production.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Lifetime of issued room tokens, in seconds.
TOKEN_TTL_SECONDS=3600
# Expose POST /api/token for anonymous demo sign-in. Disable when tokens come from a real IdP.
ALLOW_DEV_TOKENS=true

# Persistence backend: sqlite | file | auto (auto = sqlite, falling back to file if the native module fails to load)
PERSISTENCE=auto
DATA_DIR=.data

# Compact a room's update log into a single snapshot after this many updates...
COMPACTION_UPDATE_THRESHOLD=500
# ...and at least this often for rooms with pending updates.
COMPACTION_INTERVAL_MS=60000
# Unload a room from memory this long after its last client disconnects.
ROOM_IDLE_TTL_MS=30000

# Ping clients at this interval; a client that misses one pong is terminated.
HEARTBEAT_INTERVAL_MS=15000
# Close slow consumers once this many bytes are queued on their socket.
MAX_BUFFERED_BYTES=4194304
# Reject inbound frames larger than this.
MAX_MESSAGE_BYTES=2097152

# ---- web (apps/web) ----
# Where the dev server proxies /api and /rooms. Leave empty in production to use same-origin.
VITE_SERVER_URL=
